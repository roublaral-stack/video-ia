{
  "name": "plantes-bulles-reel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts PlantesBulles out/plantes-bulles-remotion.mp4 --concurrency=2 --is-production=false",
    "typecheck": "tsc --noEmit",
    "render:cloud": "remotion render src/index.ts PlantesBulles out/plantes-bulles-remotion.mp4 --concurrency=2 --is-production=false --browser-executable=/usr/bin/chromium",
    "render:fallback": ".venv/bin/python scripts/render-fallback.py",
    "project": "node scripts/project.mjs",
    "editor": "node scripts/editor.mjs",
    "test": "node --test tests/*.test.mjs",
    "produce": "node scripts/pipeline/run.mjs"
  },
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "0.3.5",
    "@remotion/cli": "4.0.543",
    "@remotion/media": "4.0.543",
    "@remotion/transitions": "4.0.543",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.543",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "playwright-core": "1.58.2",
    "typescript": "5.9.3"
  },
  "type": "module"
}
